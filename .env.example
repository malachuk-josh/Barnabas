# --- Required ---
# Anthropic API key for Claude (https://console.anthropic.com). Server-side only.
ANTHROPIC_API_KEY=
# Long random string used to sign session cookies (at least 32 characters).
SESSION_SECRET=
# Access code leaders enter on the sign-in screen to join this church.
BARNABAS_ACCESS_CODE=

# --- Storage (pick one; Vercel's Upstash Redis integration sets the KV_* pair) ---
KV_REST_API_URL=
KV_REST_API_TOKEN=
# or UPSTASH_REDIS_REST_URL / UPSTASH_REDIS_REST_TOKEN
# or a TCP connection string:
REDIS_URL=

# Comma-separated emails of the administrators who set leaders' roles in Settings -> Team
# (pastor, treasurer, deacon, staff, leader). They start as pastor; everyone else starts as leader.
BARNABAS_ADMIN_EMAILS=

# --- Optional ---
# Church name shown in the app and given to Barnabas.
BARNABAS_CHURCH_NAME=Grace Fellowship (demo)
# Model and effort for conversations (defaults: claude-opus-5-5, low).
BARNABAS_MODEL=claude-opus-5-5
BARNABAS_EFFORT=low
# Spoken turns use a faster model (thinking kept to a minimum) so Barnabas starts talking sooner.
BARNABAS_VOICE_MODEL=claude-sonnet-5-5
# Effort for post-call memory consolidation (default: medium).
BARNABAS_MEMORY_EFFORT=medium
# Set to "true" only if your church's written policy allows Barnabas to remember
# sensitive pastoral details (health, counseling, family conflict).
BARNABAS_ALLOW_SENSITIVE_MEMORY=false

# --- Calendar sync (optional) ---
# Public address of the app, used for sign-in redirects. Defaults to the address the request came in on.
APP_URL=https://barnabas-three.vercel.app
# Google Calendar two-way sync (Google Cloud OAuth client, Web application).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Outlook two-way sync (Microsoft Entra app registration).
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# --- Barnabas's voice (optional; without these the device's built-in voice is used) ---
# ElevenLabs: Barnabas's natural voice. ELEVENLABS_VOICE_ID is the church default (e.g. your cloned voice).
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_v4_turbo
# Local testing only: point the admin voice test (/voice-test) at a fake Text to Dialogue socket,
# e.g. ws://127.0.0.1:8765 from `node scripts/fake-elevenlabs-ws.mjs 8765`. Leave unset in production.
ELEVENLABS_WS_URL=
# Deepgram: streaming listening with congregation names boosted; enables hands-free mode.
DEEPGRAM_API_KEY=
